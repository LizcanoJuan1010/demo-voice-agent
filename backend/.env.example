# SQLite — cero infraestructura externa. El archivo se crea automáticamente.
DATABASE_URL="file:./prisma/dev.db"

# Voz — Deepgram Voice Agent (https://console.deepgram.com, $200 créditos gratis).
DEEPGRAM_API_KEY=

# LLM opcional — DeepSeek como LLM BYO detrás de Deepgram.
# Sin estas variables, Deepgram usa su LLM gestionado (gpt-4o-mini).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
