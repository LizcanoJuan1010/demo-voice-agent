generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "sqlite"
}

// Cuenta de cobranza (read-only). Los montos se guardan en centavos (Int)
// para evitar errores de punto flotante con dinero.
model Account {
  id                  String   @id @default(cuid())
  consumerName        String
  accountNumber       String   @unique
  cardLastFour        String
  creditor            String
  balanceOwedCents    Int
  daysPastDue         Int
  minimumPaymentCents Int
  pastDueAmountCents  Int
  monthlyPaymentCents Int
  createdAt           DateTime @default(now())

  @@map("accounts")
}

model Call {
  id            String   @id @default(cuid())
  status        String   @default("in_progress")
  outcome       String?
  promiseAmount Float?
  promiseDate   String?
  summary       String?
  transcript    Json?
  metadata      Json?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("calls")
}
